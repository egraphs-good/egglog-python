from collections.abc import Callable
from typing import final

__all__ = ["PrimitiveFailure", "_ProtoEngine", "_export_pyobject_catalog"]

class PrimitiveFailure(Exception): ...  # noqa: N818

@final
class _ProtoSource:
    def next_submission(self) -> tuple[str, bytes | None, int] | None: ...

@final
class _ProtoEngine:
    def __init__(self) -> None: ...
    @staticmethod
    def source(text: str) -> _ProtoSource: ...
    def produce_input(self, descriptor: bytes, table: str, path: str) -> bytes: ...
    def enable_recording(self) -> None: ...
    def prepare_recording(self, program: bytes) -> None: ...
    def prepare_recording_scope(self, push: bool) -> None: ...
    def finish_recording(self, success: bool) -> None: ...
    def recorded_source(self) -> str: ...
    def close_recording(self) -> None: ...
    def create(self, request: bytes) -> bytes: ...
    def run(self, request: bytes) -> tuple[bytes, BaseException | None]: ...
    def register_cost_model(
        self,
        handle: int,
        sorts: bytes,
        annotation: int,
        objective: int,
        additive: bool,
        factory: Callable[[bytes], object],
    ) -> str: ...
    def release_cost_model(self, handle: int, name: str) -> None: ...
    def clone_graph(self, request: bytes) -> bytes: ...
    def destroy(self, request: bytes) -> bytes: ...
    def configure_resources(self, request: bytes) -> bytes: ...
    def return_to(self, request: bytes) -> bytes: ...
    def get_history(self, request: bytes) -> bytes: ...

def _export_pyobject_catalog() -> bytes: ...
