[case eqAllowed]
from egglog import *
_ = i64(0) == i64(0)

[case notEqAllowed]
from egglog import *
_ = i64(0) != i64(0)

[case parameterizedVar]
from egglog import *
value = var("value", Vec[i64])
reveal_type(value)  # N: Revealed type is "egglog.builtins.Vec[egglog.builtins.i64]"

[case eqToAllowed]
from egglog import *
_ = eq(i64(0)).to(i64(0))

[case eqToNotAllowed]
from egglog import *
_ = eq(i64(0)).to(Unit()) # E: Argument 1 to "to" of "_EqBuilder" has incompatible type "Unit"; expected "i64"

[case functionPrimitiveMergeAllowed]
from egglog import *
@function(merge=lambda old, new: old)
def f(x: i64Like) -> i64: ...

[case functionEqsortCostAllowed]
from egglog import *
class A(Expr): ...
@function(cost=1)
def f() -> A: ...

[case functionEqsortRulesetSubsumeAllowed]
from egglog import *
class A(Expr): ...
r = ruleset()
@function(ruleset=r, subsume=True)
def f() -> A: ...

[case functionPrimitiveCostRejected]
from egglog import *
@function(cost=1)  # E: Value of type variable "CONSTRUCTOR_CALLABLE" of function cannot be "Callable[[], i64]"
def f() -> i64: ...

[case functionPrimitiveRulesetSubsumeRejected]
from egglog import *
r = ruleset()
@function(ruleset=r, subsume=True)  # E: Value of type variable "CONSTRUCTOR_CALLABLE" of function cannot be "Callable[[], i64]"
def f() -> i64: ...

[case extractMultipleTypes]
from typing import assert_type
from egglog import BaseExpr, DagCostModel, EGraph, i64

def tree_model(egraph: EGraph, expr: BaseExpr, children_costs: list[bool]) -> bool:
    return any(children_costs)

def marginal_cost(graph: EGraph, node: BaseExpr) -> float:
    return 1.0

graph = EGraph()
model = DagCostModel(marginal_cost, 0.0)
assert_type(graph.extract_multiple(i64(1), 2), list[i64])
assert_type(graph.extract_multiple([i64(1)], 2), list[list[i64]])
assert_type(graph.extract_multiple(i64(1), 2, cost_model=tree_model), list[i64])
assert_type(graph.extract_multiple([i64(1)], 2, cost_model=model), list[list[i64]])
assert_type(graph.extract_multiple(i64(1), 2, include_cost=True), list[tuple[i64, int]])
assert_type(graph.extract_multiple([i64(1)], 2, include_cost=True), list[list[tuple[i64, int]]])
assert_type(graph.extract_multiple(i64(1), 2, include_cost=True, cost_model=tree_model), list[tuple[i64, bool]])
assert_type(graph.extract_multiple([i64(1)], 2, include_cost=True, cost_model=tree_model), list[list[tuple[i64, bool]]])
assert_type(graph.extract_multiple(i64(1), 2, include_cost=True, cost_model=model), list[tuple[i64, float]])
assert_type(graph.extract_multiple([i64(1)], 2, include_cost=True, cost_model=model), list[list[tuple[i64, float]]])
